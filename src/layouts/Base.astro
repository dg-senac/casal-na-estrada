---
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/500.css';
import '@fontsource/bodoni-moda/400-italic.css';
import '@fontsource/bodoni-moda/500-italic.css';
import '@fontsource/bodoni-moda/700.css';
import '@fontsource/barlow-condensed/400.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.descricao,
  image = '/media/emblema.jpg',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.nome}` : `${site.nome} · ${site.nomes}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://casalnaestrada.com.br');
import { url } from '../lib/url';

// Ficha do site para os buscadores (schema.org).
const fichaSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.nome,
  alternateName: site.nomes,
  url: canonical.origin + url('/'),
  description: site.descricao,
  inLanguage: 'pt-BR',
  publisher: {
    '@type': 'Organization',
    name: site.nome,
    logo: new URL(url('/media/logo-144.png'), canonical).href,
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#15120e" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url(image), canonical).href} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={url("/favicon-48.png")} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={url("/media/icone-180.png")} />
    <link rel="manifest" href={url("/manifest.webmanifest")} />
    <link rel="alternate" type="application/rss+xml" title={`${site.nome} — Diário`} href={url("/rss.xml")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(fichaSite)} />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <div class="zoom" id="zoom" hidden>
      <button class="zoom__fechar" type="button" data-zoom-fechar aria-label="Fechar a foto">
        Fechar ✕
      </button>
      <img id="zoom-img" alt="" />
      <p class="zoom__dica">Clique fora ou aperte Esc para voltar</p>
    </div>

    <script>
      /*
       * 1) Moldura proporcional: cada espaço de foto recebe a proporção da
       *    imagem, mas com um teto e um piso — assim foto em pé não perde
       *    quase nada e o bloco não vira um poste. (Segue recortando de leve;
       *    a foto inteira aparece no zoom, clicando nela.)
       * 2) Zoom: qualquer elemento com [data-ampliar] abre a foto original
       *    em tela cheia. Em links, nada é aberto — o link continua linkando.
       */
      const MOLDURAS = [
        '.headline__media',
        '.ultima__media',
        '.post__media',
        '.hero-post__photo',
        '.album__photo',
        '.foto__btn',
        '.sobre__foto .photo',
        '.peca__foto',
        '.extras__foto',
      ].join(',');

      const PROPORCAO_MINIMA = 0.85; // piso: no máximo ~8% mais alta que larga
      const PROPORCAO_MAXIMA = 2.2; // teto: no máximo ~2,2x mais larga que alta

      const ajustarFoto = (moldura: HTMLElement) => {
        const img = moldura.querySelector('img');
        if (!img) return;

        const aplicar = () => {
          const { naturalWidth: w, naturalHeight: h } = img;
          if (!w || !h) return;
          const real = w / h;
          const proporcao = Math.min(PROPORCAO_MAXIMA, Math.max(PROPORCAO_MINIMA, real));
          moldura.style.aspectRatio = String(proporcao);
          moldura.classList.add('foto-proporcao');

          // Ponto focal escolhido no painel manda em tudo.
          const foco = moldura.dataset.foco?.trim();
          if (foco) img.style.objectPosition = foco;
          // Sem ponto focal e foto em pé: puxa o recorte para cima, para não
          // comer cabeça.
          else if (real < 0.95) img.style.objectPosition = '50% 32%';
        };

        if (img.complete) aplicar();
        else img.addEventListener('load', aplicar, { once: true });
      };

      document.querySelectorAll<HTMLElement>(MOLDURAS).forEach(ajustarFoto);

      // ----------------------------------------------------------- zoom
      const caixaZoom = document.getElementById('zoom');
      const imagemZoom = document.getElementById('zoom-img') as HTMLImageElement | null;

      const fecharZoom = () => {
        if (!caixaZoom) return;
        caixaZoom.hidden = true;
        if (imagemZoom) imagemZoom.removeAttribute('src');
        document.documentElement.style.overflow = '';
      };

      const abrirZoom = (img: HTMLImageElement) => {
        if (!caixaZoom || !imagemZoom) return;
        imagemZoom.src = img.currentSrc || img.src;
        imagemZoom.alt = img.alt;
        caixaZoom.hidden = false;
        document.documentElement.style.overflow = 'hidden';
      };

      /** Descobre qual imagem o gatilho manda ampliar. */
      const imagemDoGatilho = (gatilho: HTMLElement): HTMLImageElement | null => {
        const seletor = gatilho.getAttribute('data-ampliar');
        if (seletor && seletor !== '') return document.querySelector<HTMLImageElement>(seletor);
        return gatilho.querySelector('img');
      };

      document.addEventListener('click', (ev) => {
        const alvo = ev.target as HTMLElement | null;
        if (!alvo || !caixaZoom) return;

        if (alvo === caixaZoom || alvo.closest('[data-zoom-fechar]')) {
          fecharZoom();
          return;
        }

        const gatilho = alvo.closest<HTMLElement>('[data-ampliar]');
        if (!gatilho) return;

        const img = imagemDoGatilho(gatilho);
        if (!img) return;

        ev.preventDefault();
        abrirZoom(img);
      });

      document.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape') {
          fecharZoom();
          return;
        }

        if (ev.key !== 'Enter' && ev.key !== ' ') return;

        // <div data-ampliar> não abre com teclado sozinho; botões e links já abrem.
        const alvo = ev.target as HTMLElement | null;
        const gatilho = alvo?.closest?.<HTMLElement>('[data-ampliar]');
        if (!gatilho || ['BUTTON', 'A', 'INPUT'].includes(gatilho.tagName)) return;

        const img = imagemDoGatilho(gatilho);
        if (!img) return;

        ev.preventDefault();
        abrirZoom(img);
      });

      // Entrada suave dos blocos conforme rolam na tela.
      const items = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>

<style>
  .zoom[hidden] {
    display: none;
  }

  .zoom {
    position: fixed;
    inset: 0;
    z-index: 900;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 3vw, 2.6rem);
    background: rgba(13, 11, 8, 0.95);
  }

  .zoom img {
    max-width: 100%;
    max-height: 84vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(236, 229, 214, 0.18);
  }

  .zoom__fechar {
    position: absolute;
    top: clamp(0.8rem, 2vw, 1.6rem);
    right: clamp(0.8rem, 2vw, 1.6rem);
    background: rgba(20, 17, 12, 0.85);
    color: var(--ink);
    border: 1px solid rgba(236, 229, 214, 0.35);
    padding: 0.45rem 0.85rem;
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .zoom__fechar:hover {
    background: var(--rust);
    border-color: var(--rust);
  }

  .zoom__dica {
    position: absolute;
    bottom: clamp(0.8rem, 2vw, 1.6rem);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(236, 229, 214, 0.55);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .zoom__dica {
      display: none;
    }
  }
</style>
</html>
