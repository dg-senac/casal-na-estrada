---
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/500.css';
import '@fontsource/bodoni-moda/400-italic.css';
import '@fontsource/bodoni-moda/500-italic.css';
import '@fontsource/bodoni-moda/700.css';
import '@fontsource/barlow-condensed/400.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

import Header from '../components/Header.astro';
import BarraAdmin from '../components/BarraAdmin.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.descricao,
  image = '/media/emblema.jpg',
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.nome}` : `${site.nome} · ${site.nomes}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://casalnaestrada.com.br');
import { url } from '../lib/url';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#ece5d6" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url(image), canonical).href} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/media/logo-144.png")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <BarraAdmin />
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script>
      /*
       * Foto em pé não é cortada: quando a imagem carrega, a moldura recebe a
       * proporção real dela (em vez da proporção fixa do layout). Foto em pé
       * fica em pé, foto deitada fica deitada — e nunca sobra corte.
       * Se o JS não rodar, tudo continua como antes.
       */
      const MOLDURAS = [
        '.headline__media',
        '.ultima__media',
        '.post__media',
        '.hero-post__photo',
        '.album__photo',
        '.foto__btn',
        '.sobre__foto .photo',
        '.peca__foto',
        '.extras__foto',
      ].join(',');

      const ajustarFoto = (moldura: HTMLElement) => {
        const img = moldura.querySelector('img');
        if (!img) return;

        const aplicar = () => {
          const { naturalWidth: w, naturalHeight: h } = img;
          if (!w || !h) return;
          const proporcao = `${w} / ${h}`;
          moldura.style.aspectRatio = proporcao;
          moldura.style.height = 'auto';
          moldura.classList.add('foto-inteira');
        };

        if (img.complete) aplicar();
        else img.addEventListener('load', aplicar, { once: true });
      };

      document.querySelectorAll<HTMLElement>(MOLDURAS).forEach(ajustarFoto);

      // Entrada suave dos blocos conforme rolam na tela.
      const items = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
