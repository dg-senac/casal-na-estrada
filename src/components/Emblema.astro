---
/**
 * Emblema do casal — selo de moto clube com a caveira no centro.
 *
 * É desenhado em SVG (e não numa imagem) para usar a Barlow Condensed do
 * próprio site nas letras curvas do selo. Nada aqui é foto: são só anéis,
 * tipografia e a caveira.
 */
interface Props {
  /** Texto de cima, em arco. */
  topo?: string;
  /** Texto de baixo, em arco. */
  base?: string;
  class?: string;
}

const {
  topo = 'CASAL NA ESTRADA',
  base = 'RECIFE — PERNAMBUCO',
  class: classe,
} = Astro.props;

const caveira =
  'M28 12.6C20.6 12.6 15.3 17.8 15.3 24.7C15.3 28.5 16.5 31.4 18.5 33.6C19.6 34.8 20.2 36 20.2 37.4L20.2 40.6C20.2 42.7 21.7 44.2 23.7 44.2L32.3 44.2C34.3 44.2 35.8 42.7 35.8 40.6L35.8 37.4C35.8 36 36.4 34.8 37.5 33.6C39.5 31.4 40.7 28.5 40.7 24.7C40.7 17.8 35.4 12.6 28 12.6Z' +
  'M19.6 25.2a3.6 4.1 0 1 0 7.2 0a3.6 4.1 0 1 0 -7.2 0Z' +
  'M29.2 25.2a3.6 4.1 0 1 0 7.2 0a3.6 4.1 0 1 0 -7.2 0Z' +
  'M28 29.9L26.2 34.7L29.8 34.7Z' +
  'M22.4 38.2h1.5v3.6h-1.5Z' +
  'M25.6 38.2h1.5v3.6h-1.5Z' +
  'M28.9 38.2h1.5v3.6h-1.5Z' +
  'M32.1 38.2h1.5v3.6h-1.5Z';
---

<svg
  xmlns:xlink="http://www.w3.org/1999/xlink"
  class:list={['emblema', classe]}
  viewBox="0 0 400 400"
  role="img"
  aria-label={`Emblema do Casal na Estrada: caveira em selo de moto clube, ${base}`}
>
  <defs>
    <path id="emblema-arco-topo" d="M 52 200 A 148 148 0 0 1 348 200" fill="none" />
    <path id="emblema-arco-base" d="M 92 216 A 108 108 0 0 0 308 216" fill="none" />
  </defs>

  <!-- aros do selo -->
  <circle cx="200" cy="200" r="192" fill="none" stroke="currentColor" stroke-width="7" />
  <circle cx="200" cy="200" r="178" fill="none" stroke="currentColor" stroke-width="1.4" />
  <circle cx="200" cy="200" r="122" fill="none" stroke="var(--rust)" stroke-width="2.2" />
  <circle cx="200" cy="200" r="117" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.5" />

  <!-- letras do selo -->
  <text
    class="emblema__texto"
    fill="currentColor"
    font-size="35"
    font-weight="600"
    letter-spacing="7"
    text-anchor="middle"
  >
    <textPath href="#emblema-arco-topo" xlink:href="#emblema-arco-topo" startOffset="50%">{topo}</textPath>
  </text>
  <text
    class="emblema__texto"
    fill="currentColor"
    font-size="21"
    font-weight="500"
    letter-spacing="6"
    text-anchor="middle"
    opacity="0.78"
  >
    <textPath href="#emblema-arco-base" xlink:href="#emblema-arco-base" startOffset="50%">{base}</textPath>
  </text>

  <!-- a caveira -->
  <g transform="translate(200 198) scale(5) translate(-28 -28)">
    <path d={caveira} fill="currentColor" fill-rule="evenodd" />
  </g>
</svg>

<style>
  .emblema {
    width: 100%;
    height: 100%;
    display: block;
    color: var(--ink);
  }

  /* Barlow Condensed dá o ar de selo de MC; o resto do site não muda. */
  .emblema__texto {
    font-family: var(--sans);
  }
</style>
