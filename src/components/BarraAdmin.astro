---
/**
 * Faixa que aparece no topo do site SÓ quando o navegador já entrou no /admin.
 * Para qualquer visitante ela nem existe na tela (o script só a revela se o
 * navegador tiver o marcador do painel).
 */
import { url } from '../lib/url';
---

<div class="barra-admin" id="barra-admin" hidden>
  <span class="barra-admin__selo">Modo admin</span>
  <a class="barra-admin__link" href={url('/admin')}>Painel</a>
  <a class="barra-admin__link" href={url('/diario')}>Diário</a>
  <a class="barra-admin__link" href={url('/galeria')}>Galeria</a>
  <a class="barra-admin__link" href={url('/trofeus')}>Troféus</a>
  <a class="barra-admin__link" href={url('/encontros')}>Encontros</a>
  <span class="barra-admin__dica">ao salvar, o site publica em ~1 min</span>
</div>

<script>
  if (localStorage.getItem('cne-admin') === '1') {
    document.getElementById('barra-admin')?.removeAttribute('hidden');
  }
</script>

<style>
  .barra-admin[hidden] {
    display: none !important;
  }

  .barra-admin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    padding: 0.42rem var(--gutter);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    position: relative;
    z-index: 60;
  }

  .barra-admin__selo {
    color: #d98b74;
    font-weight: 600;
  }

  .barra-admin__link {
    color: rgba(236, 229, 214, 0.82);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .barra-admin__link:hover {
    color: #fff;
    border-bottom-color: var(--rust-soft);
  }

  .barra-admin__dica {
    margin-left: auto;
    color: rgba(236, 229, 214, 0.45);
    letter-spacing: 0.04em;
    text-transform: none;
    font-family: var(--body);
    font-size: 0.72rem;
  }
</style>
