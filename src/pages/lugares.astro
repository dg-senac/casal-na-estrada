---
import Base from '../layouts/Base.astro';
import { marcosEstrada, primeiraViagem } from '../data/marcos-estrada';
import MapaViagens from '../components/MapaViagens.astro';
import { carregarPosts, carregarTrofeus, postsNoAr } from '../lib/dados';
import { lugares } from '../lib/estrada';
import { url } from '../lib/url';

const posts = postsNoAr(await carregarPosts());
const trofeus = (await carregarTrofeus()).filter((t) => !t.data.rascunho);
const grupos = lugares(posts, trofeus, marcosEstrada);

const totalLugares = new Set(grupos.flatMap((g) => g.lugares.map((l) => `${l.uf ?? ''}|${l.nome.toLowerCase()}`))).size;
const totalEstados = grupos.filter((g) => g.uf).length;
---

<Base
  title="Onde a gente já esteve"
  description="Índice das cidades e estados por onde Cieri e Milla já rodaram de moto — com as publicações e as peças da sala de troféus de cada lugar."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Mapa de papel · {totalLugares} lugares · {totalEstados} estados</p>
      <h1 class="display">Onde a gente <em>já esteve</em></h1>
      <div class="page-head__bottom">
        <p>
          Tudo o que está aqui saiu do nosso próprio caderno: cada viagem tem uma cidade, cada
          troféu tem uma origem. No mapa e na lista abaixo, dá para abrir as histórias de cada destino — só com
          o que a estrada deixou.
        </p>
        <span class="small-caps">Por estado, do mais visitado ao menos</span>
      </div>
    </div>
  </header>

  <section class="section section--tight" aria-labelledby="primeira-estrada-titulo">
    <div class="wrap">
      <article class="primeira-estrada">
        <div class="primeira-estrada__selo" aria-hidden="true">
          <span>O primeiro capítulo</span>
          <strong>{primeiraViagem.ano}</strong>
          <span>Recife · Salvador</span>
        </div>
        <div class="primeira-estrada__texto">
          <p class="eyebrow">Lugar de honra · nossa primeira grande viagem</p>
          <h2 id="primeira-estrada-titulo">Bahia, onde a estrada <em>virou história.</em></h2>
          <p>
            Em 2023, saímos do Recife na Yamaha Lander 250 rumo à Bahia. A chegada a
            Salvador marcou a primeira grande viagem oficial do Casal na Estrada —
            um capítulo que merece sua própria bandeira e um lugar especial entre todos os destinos.
          </p>
          <p class="primeira-estrada__legado">Antes de tantas lembranças, houve essa primeira estrada. E ela segue com a gente.</p>
          <a class="link-arrow" href={url(primeiraViagem.href)}>Relembrar o começo da nossa história →</a>
        </div>
      </article>
    </div>
  </section>

  <MapaViagens posts={posts} trofeus={trofeus} marcos={marcosEstrada} />

  <section class="section section--tight">
    <div class="wrap">
      {
        grupos.map((grupo) => (
          <div class="estado" id={`uf-${grupo.uf ?? 'sem-uf'}`}>
            <header class="estado__head">
              <h2 class="estado__nome">{grupo.estado}</h2>
              <span class="estado__qtd">
                {grupo.publicacoes > 0 && `${grupo.publicacoes} ${grupo.publicacoes === 1 ? 'publicação' : 'publicações'}`}
                {grupo.publicacoes > 0 && grupo.pecas > 0 && ' · '}
                {grupo.pecas > 0 && `${grupo.pecas} ${grupo.pecas === 1 ? 'peça' : 'peças'}`}
                {grupo.lugares.some(l => l.marcos?.length) && `${grupo.publicacoes + grupo.pecas > 0 ? ' · ' : ''}Marco da nossa história`}
              </span>
              <span class="estado__linha" aria-hidden="true" />
            </header>

            <ul class="lugares">
              {grupo.lugares.map((lugar) => (
                <li class="lugar">
                  <a class="lugar__nome" href={url(lugar.marcos?.[0]?.href ?? `/diario?lugar=${encodeURIComponent(lugar.nome)}`)}>
                    {lugar.nome}
                  </a>
                  <span class="lugar__nums">
                    {lugar.marcos?.map(m => <span>Primeira grande viagem · {m.ano}</span>)}
                    {lugar.publicacoes > 0 && (
                      <span>{lugar.publicacoes} {lugar.publicacoes === 1 ? 'publicação' : 'publicações'}</span>
                    )}
                    {lugar.publicacoes > 0 && lugar.pecas > 0 && <span class="lugar__ponto">·</span>}
                    {lugar.pecas > 0 && (
                      <span>{lugar.pecas} {lugar.pecas === 1 ? 'peça' : 'peças'}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      {
        grupos.length === 0 && (
          <p class="vazio-bloco__texto">Nada registrado ainda: o mapa começa na próxima viagem.</p>
        )
      }
    </div>
  </section>

  <section class="section section--ink section--tight">
    <div class="wrap pendente">
      <div>
        <p class="eyebrow eyebrow--light">Continua crescendo</p>
        <h2 class="pendente__title">Cada viagem <em>finca uma bandeira</em>.</h2>
      </div>
      <div>
        <p>
          Este índice é montado sozinho: quando vocês publicam uma história com cidade e
          UF ou selecionam os destinos no painel, ela entra aqui na próxima atualização — e cada peça da sala de troféus já traz o lugar
          de onde veio.
        </p>
        <a class="link-arrow" href={url('/linha-do-tempo')} style="color:var(--ink)">Ver a linha do tempo →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .primeira-estrada {
    /* Ilha clara no tema escuro: toda a tinta é definida localmente. */
    --ink: #29251f;
    --ink-2: #3d372f;
    --ink-soft: #51483d;
    --ink-mute: #625647;
    --rust-text: #96341f;
    color: var(--ink);
    display: grid;
    grid-template-columns: minmax(160px, .65fr) 2fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--ink);
    border-top: 4px solid var(--ink);
    background: #eee8dc;
  }
  .primeira-estrada__selo {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .8rem; padding: 1rem; text-align: center;
    border: 1px solid currentColor;
  }
  .primeira-estrada__selo strong { font-size: clamp(2.5rem, 6vw, 5rem); line-height: 1; }
  .primeira-estrada__texto h2 { margin: .8rem 0 1rem; }
  .primeira-estrada__texto p { max-width: 65ch; }
  .primeira-estrada__legado { margin: 1rem 0 1.5rem; font-style: italic; }
  @media (max-width: 640px) {
    .primeira-estrada { grid-template-columns: 1fr; }
    .primeira-estrada__selo { padding: 1.2rem; }
  }

  .estado {
    padding-block: clamp(1.4rem, 2.6vw, 2rem);
    scroll-margin-top: 120px;
  }

  .estado + .estado {
    border-top: 1px solid var(--line);
  }

  .estado__head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .estado__nome {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .estado__qtd {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .estado__linha {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
    transform: translateY(-4px);
  }

  .lugares {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.2rem 2rem;
    max-width: 90ch;
  }

  .lugar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.45rem;
    border-bottom: 1px dotted var(--line-strong);
  }

  .lugar__nome {
    font-family: var(--serif);
    font-size: 1.02rem;
    border-bottom: 1px solid transparent;
  }

  .lugar__nome:hover {
    color: var(--rust-text);
    border-bottom-color: var(--rust);
  }

  .lugar__nums {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .lugar__ponto {
    opacity: 0.5;
  }
</style>
