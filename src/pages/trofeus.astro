---
import Base from '../layouts/Base.astro';
import { carregarTrofeus } from '../lib/dados';
import { url } from '../lib/url';
import { capa, capaAlt, metaData, ordenar, porCategoria, quando, selo } from '../lib/trofeus';

const trofeus = (await carregarTrofeus()).filter((t) => !t.data.rascunho);
const grupos = porCategoria(trofeus);

const ultima = ordenar(trofeus)[0];
---

<Base
  title="Sala de Troféus"
  description="A sala de troféus do Casal na Estrada: troféus, placas e lembranças de cada encontro de moto, com a história de como cada peça chegou na prateleira."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Prateleira da sala · {trofeus.length} peças fotografadas</p>
      <h1 class="display">Sala de Troféus</h1>
      <div class="page-head__bottom">
        <p>
          Nem tudo aqui é prêmio de pódio: a maior parte são placas, troféus de participação,
          lembranças de viagem e uma coisa ou outra feita em casa. A prateleira está dividida
          por tipo de peça — e cada uma tem o encontro, a cidade e a história anotados atrás.
        </p>
        <div class="contagem">
          {grupos.map((g) => (
            <span>
              <strong>{g.pecas.length}</strong> {g.titulo.toLowerCase()}
            </span>
          ))}
        </div>
      </div>
    </div>
  </header>

  {
    grupos.length > 0 && (
      <nav class="indice" aria-label="Pular para uma categoria">
        <div class="wrap indice__in">
          <span class="indice__rotulo">Prateleira por categoria</span>
          <ul class="indice__lista">
            {grupos.map((g) => (
              <li>
                <a href={`#cat-${g.id}`}>
                  {g.titulo} <span class="indice__qtd">{g.pecas.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }

  <section class="section section--tight">
    <div class="wrap">
      {
        grupos.map((grupo) => (
          <div class="grupo" id={`cat-${grupo.id}`}>
            <header class="grupo__head">
              <h2 class="grupo__titulo">{grupo.titulo}</h2>
              <span class="grupo__qtd">
                {grupo.pecas.length} {grupo.pecas.length === 1 ? 'peça' : 'peças'}
              </span>
              <span class="grupo__linha" aria-hidden="true" />
            </header>
            <p class="grupo__resumo">{grupo.resumo}</p>

            <div class="grade">
              {grupo.pecas.map((t, i) => (
                <article class="peca rebite" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
                  <a class="peca__link" href={url(`/trofeus/${t.id}`)}>
                    <div class="peca__foto" data-foco={t.data.fotoFoco}>
                      {capa(t) ? (
                        <img
                          src={url(t.data.fotoMini ?? capa(t)!)}
                          srcset={t.data.fotoMini ? `${url(t.data.fotoMini)} 900w, ${url(capa(t)!)} 2000w` : undefined}
                          sizes={t.data.fotoMini ? '(max-width: 700px) 90vw, 30vw' : undefined}
                          alt={capaAlt(t)}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="peca__sem-foto">Sem foto ainda</span>
                      )}
                      <span class="peca__selo">{selo(t)}</span>
                    </div>

                    <div class="peca__info">
                      <p class="peca__meta">
                        {t.data.cidade && <span>{t.data.cidade}</span>}
                        {t.data.cidade && metaData(t) && <span class="peca__ponto">·</span>}
                        {metaData(t) && <span>{metaData(t)}</span>}
                        {!t.data.cidade && !metaData(t) && <span>Prateleira de casa</span>}
                      </p>
                      <h3 class="peca__titulo">{t.data.evento}</h3>
                      <p class="peca__historia">{t.data.historia}</p>
                      <span class="link-arrow">Ler a história</span>
                    </div>
                  </a>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--ink section--tight">
    <div class="wrap pendente">
      <div>
        <p class="eyebrow eyebrow--light">Esta página cresce com o tempo</p>
        <h2 class="pendente__title">A prateleira enche a cada <em>fim de semana</em>.</h2>
      </div>
      <div>
        <p>
          Cada encontro do ano rende uma peça nova e o casal mesmo abastece esta sala: chega da
          viagem, fotografa o troféu e escreve a história. Por isso a página nunca fica
          pronta — e é assim que a gente gosta.
        </p>
        {ultima && (
          <p class="small-caps" style="margin:0">
            Última peça: {ultima.data.evento} · {quando(ultima)}
          </p>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .contagem {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .contagem strong {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--ink);
    margin-right: 0.15rem;
  }

  /* ---------- Índice por categoria ---------- */

  .indice {
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }

  .indice__in {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    padding-block: 0.7rem;
  }

  .indice__rotulo {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .indice__lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .indice__lista a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding-bottom: 0.1rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .indice__lista a:hover {
    color: var(--rust-text);
    border-bottom-color: var(--rust);
  }

  .indice__qtd {
    font-size: 0.68rem;
    color: var(--ink-mute);
  }

  /* ---------- Bloco de uma categoria ---------- */

  .grupo {
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    scroll-margin-top: 120px;
  }

  .grupo + .grupo {
    border-top: 1px solid var(--line);
  }

  .grupo__head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.7rem;
  }

  .grupo__titulo {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .grupo__qtd {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .grupo__linha {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
    transform: translateY(-4px);
  }

  .grupo__resumo {
    max-width: 64ch;
    margin: 0 0 clamp(1.1rem, 2vw, 1.7rem);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* ---------- Cartão da peça ---------- */

  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: clamp(1.1rem, 2.2vw, 1.9rem);
  }

  .peca {
    border: 1px solid var(--line);
    background: var(--paper);
    transition: border-color 0.25s ease, transform 0.4s ease;
  }

  .peca:hover {
    border-color: var(--ink);
    transform: translateY(-3px);
  }

  .peca__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .peca__foto {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper-3);
    border-bottom: 1px solid var(--line);
  }

  /* Foto da peça, na cor original como todas as outras. */
  .peca__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: none;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .peca:hover .peca__foto img {
    transform: scale(1.04);
  }

  .peca__sem-foto {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .peca__selo {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--couro);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.3rem 0.55rem 0.26rem;
  }

  .peca__info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.95rem 1rem 1.15rem;
    flex: 1;
  }

  .peca__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
  }

  .peca__ponto {
    color: var(--rust-text);
  }

  .peca__titulo {
    font-size: clamp(1.1rem, 1.6vw, 1.28rem);
    line-height: 1.18;
    transition: color 0.25s ease;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .peca:hover .peca__titulo {
    color: var(--rust-text);
  }

  .peca__historia {
    font-size: 0.87rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0.15rem 0 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .peca__info .link-arrow {
    margin-top: auto;
    font-size: 0.74rem;
    align-self: flex-start;
  }

  /* ---------- Fecho ---------- */

  .pendente {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .pendente__title {
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    max-width: 22ch;
  }

  .pendente__title em {
    color: rgba(236, 229, 214, 0.55);
  }

  @media (max-width: 860px) {
    .pendente {
      grid-template-columns: 1fr;
    }

    .grade {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }

    .peca__historia {
      -webkit-line-clamp: 3;
    }

    .peca__info .link-arrow {
      font-size: 0.7rem;
    }
  }

  @media (max-width: 520px) {
    .grade {
      grid-template-columns: 1fr;
    }

    .peca__historia {
      -webkit-line-clamp: 4;
    }
  }
</style>
