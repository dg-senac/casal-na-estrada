---
import Base from '../layouts/Base.astro';
import { carregarEncontros } from '../lib/dados';
import { site } from '../data/site';
import { limitesEncontro, estadoEncontro } from '../lib/tempo-encontros';

const todos = (await carregarEncontros()).sort(
  (a, b) => a.data.inicio.valueOf() - b.data.inicio.valueOf()
);

const hoje = new Date();

// Agrupamento inicial no build; o navegador atualiza sem depender de novo deploy.
const estado = (e: typeof todos[number]) => {
  const t = limitesEncontro(e.data.inicio, e.data.fim);
  return estadoEncontro(t.inicio, t.fim, hoje.valueOf());
};
const confirmados = todos.filter(e => !e.data.cancelado && estado(e) !== 'passado');
const destaque = confirmados[0];
const grupos = [
  { id: 'andamento', titulo: 'Acontecendo agora', itens: todos.filter(e => estado(e) === 'andamento' && !e.data.cancelado) },
  { id: 'futuro', titulo: 'Próximos', itens: todos.filter(e => estado(e) === 'futuro' || (estado(e) === 'andamento' && e.data.cancelado)) },
  { id: 'passado', titulo: 'Já passou', itens: todos.filter(e => estado(e) === 'passado').reverse() },
];
const dadosContagem = todos.filter(e => !e.data.cancelado).map(e => ({
  ...limitesEncontro(e.data.inicio, e.data.fim), nome: e.data.nome,
  local: `${e.data.cidade} — ${e.data.uf}`,
}));

const dia = (d: Date) => new Intl.DateTimeFormat('pt-BR', { day: '2-digit' }).format(d);
const mes = (d: Date) =>
  new Intl.DateTimeFormat('pt-BR', { month: 'short' }).format(d).replace('.', '');
const ano = (d: Date) => d.getFullYear();
const completo = (d: Date) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long' }).format(d);
---

<Base
  title="Encontros"
  description="Agenda dos encontros de moto e moto casais onde Cieri e Milla vão estar."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">
        <span data-agenda-resumo>Agenda · {confirmados.length > 0
          ? `${confirmados.length} ${confirmados.length === 1 ? 'encontro' : 'encontros'} pela frente`
          : 'em preparação'}</span>
      </p>
      <h1 class="display">Encontros</h1>
      <div class="page-head__bottom">
        <p>
          Os encontros são a desculpa. O motivo é rever os amigos e conhecer gente nova. Se
          você também vai em algum desses, avisa — a gente combina de chegar junto.
        </p>
        <a
          class="btn btn--solid"
          href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Vou em um encontro também! Vamos combinar?')}`}
          target="_blank"
          rel="noopener">{confirmados.length > 0 ? 'Combinar comboio' : 'Falar com a gente'}</a
        >
      </div>
    </div>
  </header>

  {
    dadosContagem.length > 0 && (
      <section class="section section--tight" aria-label="Contagem regressiva" data-secao-contagem hidden={!destaque}>
        <div class="wrap">
          <div
            class="contagem"
            data-contagem
            data-eventos={JSON.stringify(dadosContagem)}
          >
            <div>
              <p class="eyebrow" data-contagem-titulo>{destaque && estado(destaque) === 'andamento' ? 'Já começou! Contagem para o término' : 'Contagem para o início'}</p>
              <p class="contagem__nome">{destaque?.data.nome ?? 'Agenda de encontros'}</p>
              <p class="contagem__local">
                {destaque ? `${destaque.data.cidade} — ${destaque.data.uf}` : ''}
              </p>
            </div>
            <div class="contagem__nums">
              <span><strong data-dias>—</strong><em>dias</em></span>
              <span><strong data-horas>—</strong><em>horas</em></span>
              <span><strong data-min>—</strong><em>min</em></span>
              <span><strong data-seg>—</strong><em>seg</em></span>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {grupos.map(grupo => (
  <section class="section section--tight" data-grupo={grupo.id} hidden={grupo.itens.length === 0}>
    <div class="wrap">
      <h2 class="sr-title">{grupo.titulo}</h2>
      <div class="lista">
        {
          grupo.itens.map((e, i) => (
            <article
              class:list={['evento', { 'evento--cancelado': e.data.cancelado }]}
              data-evento
              data-inicio={limitesEncontro(e.data.inicio, e.data.fim).inicio}
              data-fim={limitesEncontro(e.data.inicio, e.data.fim).fim}
              data-cancelado={String(e.data.cancelado)}
              style={`--reveal-delay:${i * 60}ms`}
            >
              <div class="evento__data">
                <span class="evento__dia">{dia(e.data.inicio)}</span>
                <span class="evento__mes">{mes(e.data.inicio)}</span>
                <span class="evento__ano">{ano(e.data.inicio)}</span>
              </div>

              <div class="evento__corpo">
                <div class="evento__topo">
                  <h3 class="evento__nome">{e.data.nome}</h3>
                  {!e.data.cancelado && <span class="evento__estado" data-estado>{estado(e) === 'andamento' ? 'Acontecendo agora' : estado(e) === 'passado' ? 'Encerrado' : 'Em breve'}</span>}
                  {e.data.cancelado && <span class="evento__cancelado">Cancelado</span>}
                  {!e.data.cancelado && !e.data.confirmado && (
                    <span class="evento__aviso">a confirmar</span>
                  )}
                </div>
                <p class="evento__local">
                  {e.data.cidade} — {e.data.uf}
                  {e.data.local && <span class="evento__extra"> · {e.data.local}</span>}
                </p>
                {e.data.fim && (
                  <p class="evento__fim">
                    De {completo(e.data.inicio)} a {completo(e.data.fim)}
                  </p>
                )}
                {!e.data.cancelado && <p class="evento__relogio" data-relogio hidden>Já começou! Termina em <strong data-restante />.</p>}
                {e.data.observacao && !e.data.cancelado && (
                  <p class="evento__obs">{e.data.observacao}</p>
                )}
                {e.data.cancelado && (
                  <p class="evento__motivo">
                    <strong>Por que cancelou:</strong>{' '}
                    {e.data.motivoCancelamento ?? 'o encontro não vai mais acontecer.'}
                  </p>
                )}
              </div>

              <div class="evento__acao">
                {!e.data.cancelado && (
                  <a
                    class="link-arrow"
                    href={`https://wa.me/${site.whatsapp}`}
                    target="_blank"
                    rel="noopener"
                  >
                    Vou também →
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  ))}
  <div class="wrap aviso-agenda" data-agenda-vazia hidden={todos.length > 0}>
    <p>A agenda nova está sendo montada. Assim que tivermos encontros cadastrados, eles aparecem aqui.</p>
  </div>

  <section class="section section--paper2 section--tight">
    <div class="wrap info">
      <div>
        <p class="eyebrow">A gente também vai</p>
        <h2 class="info__title">Encontro que não está na lista?</h2>
      </div>
      <div>
        <p>
          Manda o nome, a cidade e a data. A gente avalia a distância, o calendário — e quase
          sempre acaba indo. Estrada boa é estrada com destino.
        </p>
        <a class="btn" href={`mailto:${site.email}?subject=Indica%C3%A7%C3%A3o%20de%20encontro`}>
          Indicar um encontro
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { estadoEncontro, tempoRestante } from '../lib/tempo-encontros';
  const caixa = document.querySelector<HTMLElement>('[data-contagem]');
  const secao = document.querySelector<HTMLElement>('[data-secao-contagem]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-evento]')];
  type Evento = { inicio: number; fim: number; nome: string; local: string };
  const eventos: Evento[] = JSON.parse(caixa?.dataset.eventos ?? '[]');
  const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo]')];
  const tique = () => {
    const agora = Date.now();
    cards.forEach(card => {
      const estado = estadoEncontro(Number(card.dataset.inicio), Number(card.dataset.fim), agora);
      const cancelado = card.dataset.cancelado === 'true';
      const grupo = cancelado && estado === 'andamento' ? 'futuro' : estado;
      const lista = document.querySelector(`[data-grupo="${grupo}"] .lista`);
      if (lista && card.parentElement !== lista) {
        lista.append(card);
        [...lista.children].sort((a,b) => grupo === 'passado'
          ? Number((b as HTMLElement).dataset.inicio) - Number((a as HTMLElement).dataset.inicio)
          : Number((a as HTMLElement).dataset.inicio) - Number((b as HTMLElement).dataset.inicio))
          .forEach(el => lista.append(el));
      }
      const selo = card.querySelector('[data-estado]');
      if (selo) selo.textContent = estado === 'andamento' ? 'Acontecendo agora' : estado === 'passado' ? 'Encerrado' : 'Em breve';
      card.classList.toggle('evento--andamento', estado === 'andamento' && !cancelado);
      const relogio = card.querySelector<HTMLElement>('[data-relogio]');
      if (relogio) {
        relogio.hidden = estado !== 'andamento';
        const t = tempoRestante(Number(card.dataset.fim), agora);
        relogio.querySelector('[data-restante]')!.textContent = `${t.dias}d ${t.horas}h ${t.minutos}min ${t.segundos}s`;
      }
      const acao = card.querySelector<HTMLElement>('.evento__acao');
      if (acao) acao.hidden = estado === 'passado';
    });
    grupos.forEach(g => { g.hidden = !g.querySelector('[data-evento]'); });
    const ativos = eventos.filter(e => agora < e.fim).length;
    const resumo = document.querySelector('[data-agenda-resumo]');
    if (resumo) resumo.textContent = ativos ? `Agenda · ${ativos} ${ativos === 1 ? 'encontro na agenda' : 'encontros na agenda'}` : 'Agenda · sem novos encontros';
    const proximo = eventos.find(e => e.inicio <= agora && agora < e.fim) ?? eventos.find(e => e.inicio > agora);
    if (secao) secao.hidden = !proximo;
    if (!caixa || !proximo) return;
    const acontecendo = agora >= proximo.inicio;
    caixa.querySelector('[data-contagem-titulo]')!.textContent = acontecendo ? 'Já começou! Contagem para o término' : 'Contagem para o início';
    caixa.querySelector('.contagem__nome')!.textContent = proximo.nome;
    caixa.querySelector('.contagem__local')!.textContent = `${proximo.local} · horário de Recife · término ao final do último dia`;
    const t = tempoRestante(acontecendo ? proximo.fim : proximo.inicio, agora);
    for (const [attr, valor] of [['dias', t.dias], ['horas', t.horas], ['min', t.minutos], ['seg', t.segundos]]) {
      caixa.querySelector(`[data-${attr}]`)!.textContent = valor;
    }
  };
  tique();
  const relogio = window.setInterval(tique, 1000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) tique(); });
  window.addEventListener('pagehide', () => window.clearInterval(relogio));
</script>

<style>
  [data-grupo][hidden], [data-secao-contagem][hidden], [data-relogio][hidden], .evento__acao[hidden] { display: none; }
  .evento__estado { font: 600 .66rem var(--sans); text-transform: uppercase; letter-spacing: .1em; color: var(--ink-soft); }
  .evento--andamento .evento__estado, .evento__relogio strong { color: var(--rust-text); }
  .evento--andamento { border-left: 2px solid var(--rust); padding-left: 1rem; }
  .evento__relogio { font-size: .9rem; margin-top: .5rem; }

  .contagem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem 2.5rem;
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .contagem__nome {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.15;
    margin: 0.1rem 0 0.35rem;
  }

  .contagem__local {
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
  }

  .contagem__nums {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .contagem__nums span {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 42px;
  }

  .contagem__nums strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1;
    color: var(--rust-text);
    font-variant-numeric: tabular-nums;
  }

  .contagem__nums em {
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-top: 0.35rem;
  }

  .aviso-agenda {
    border: 1px dashed var(--line-strong);
    padding: clamp(1.3rem, 3vw, 2.1rem);
    max-width: 64ch;
  }

  .aviso-agenda__titulo {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.15;
    margin-bottom: 0.7rem;
  }

  .aviso-agenda__texto {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-bottom: 1.4rem;
  }

  .aviso-agenda__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.6rem;
  }

  .sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .lista {
    border-top: 1px solid var(--line-strong);
  }

  .evento {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: clamp(1.2rem, 2.4vw, 1.8rem);
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .evento__data {
    display: grid;
    justify-items: center;
    border: 1px solid var(--line-strong);
    padding: 0.6rem 0.4rem 0.5rem;
    background: var(--paper-2);
  }

  .evento__dia {
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 1;
  }

  .evento__mes {
    font-family: var(--sans);
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust-text);
  }

  .evento__ano {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
  }

  .evento__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }

  .evento__nome {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
  }

  .evento__aviso {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    border: 1px dashed var(--line-strong);
    padding: 0.1rem 0.4rem;
  }

  /* ---------- encontro cancelado ---------- */

  .evento--cancelado {
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      rgba(236, 228, 211, 0.028) 14px 28px
    );
  }

  .evento--cancelado .evento__nome {
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--rust);
  }

  .evento--cancelado .evento__dia,
  .evento--cancelado .evento__mes,
  .evento--cancelado .evento__ano {
    color: var(--ink-mute);
    text-decoration: line-through;
    text-decoration-color: var(--rust);
  }

  .evento__cancelado {
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust-text);
    border: 1px solid currentColor;
    padding: 0.1rem 0.42rem 0.06rem;
  }

  .evento__motivo {
    font-size: 0.92rem;
    color: var(--ink-soft);
    border-left: 2px solid var(--rust);
    padding-left: 0.75rem;
    margin: 0.55rem 0 0;
  }

  .evento__motivo strong {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust-text);
    display: block;
    margin-bottom: 0.15rem;
  }

  .evento__local {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.4rem;
  }

  .evento__extra {
    color: var(--ink-mute);
  }

  .evento__fim {
    font-size: 0.86rem;
    color: var(--ink-mute);
    margin: 0 0 0.4rem;
  }

  .evento__obs {
    font-size: 0.92rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 62ch;
  }

  .evento__acao {
    padding-top: 0.4rem;
  }

  .vazio {
    padding-block: 2rem;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .arquivo {
    background: var(--paper-2);
    border-top: 1px solid var(--line-strong);
  }

  .arquivo__lista {
    display: grid;
  }

  .passado {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.2rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }

  .passado__data {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    min-width: 105px;
  }

  .passado__nome {
    font-family: var(--serif);
    font-size: 1.05rem;
  }

  .passado__local {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-left: auto;
  }

  .info {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .info__title {
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    max-width: 22ch;
  }

  @media (max-width: 860px) {
    .evento {
      grid-template-columns: 90px minmax(0, 1fr);
    }

    .evento__acao {
      grid-column: 2;
      padding-top: 0.2rem;
    }

    .info {
      grid-template-columns: 1fr;
    }

    .passado__local {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
