---
import Base from '../layouts/Base.astro';
import { fonteEncontro, dataConferencia } from '../lib/fonte-encontro.js';
import { url } from '../lib/url';
import { carregarEncontros } from '../lib/dados';
import { site } from '../data/site';
import { limitesEncontro, estadoEncontro } from '../lib/tempo-encontros';
import { categoriaEncontro } from '../lib/categorias-encontros.js';

const todos = (await carregarEncontros()).sort(
  (a, b) => a.data.inicio.valueOf() - b.data.inicio.valueOf()
);

const estados = [...new Set(todos.map(e => e.data.uf.trim().toUpperCase()).filter(Boolean))].sort();
const compartilharEncontro = (e: typeof todos[number]) => {
  const link = new URL(`${url('/encontros/')}#encontro-${encodeURIComponent(e.id)}`, Astro.site ?? 'https://casalnaestrada.com.br');
  const texto = `${e.data.nome} — ${e.data.cidade}/${e.data.uf}\n${e.data.inicio.toLocaleDateString('pt-BR')}${e.data.fim ? ` a ${e.data.fim.toLocaleDateString('pt-BR')}` : ''}\nConfira a situação e os detalhes na agenda antes de sair: ${link.href}`;
  return `https://wa.me/?text=${encodeURIComponent(texto)}`;
};
const hoje = new Date();

// Agrupamento inicial no build; o navegador atualiza sem depender de novo deploy.
const estado = (e: typeof todos[number]) => {
  const t = limitesEncontro(e.data.inicio, e.data.fim);
  return estadoEncontro(t.inicio, t.fim, hoje.valueOf());
};
const categoria = (e: typeof todos[number]) => categoriaEncontro(estado(e), e.data.cancelado, e.data.confirmado);
const confirmados = todos.filter(e => e.data.confirmado && !e.data.cancelado && estado(e) !== 'passado');
const destaque = confirmados[0];
const grupos = [
  { id: 'andamento', titulo: 'Ocorrendo agora' },
  { id: 'futuro', titulo: 'Próximos' },
  { id: 'confirmar', titulo: 'A confirmar' },
  { id: 'passado', titulo: 'Encerrados' },
  { id: 'cancelado', titulo: 'Cancelados' },
].map(grupo => ({ ...grupo, itens: todos.filter(e => categoria(e) === grupo.id)
  .sort((a, b) => grupo.id === 'passado'
    ? b.data.inicio.valueOf() - a.data.inicio.valueOf()
    : a.data.inicio.valueOf() - b.data.inicio.valueOf()) }));
const dadosContagem = todos.filter(e => e.data.confirmado && !e.data.cancelado).map(e => ({
  ...limitesEncontro(e.data.inicio, e.data.fim), nome: e.data.nome,
  local: `${e.data.cidade} — ${e.data.uf}`, uf: e.data.uf.trim().toUpperCase(),
}));

const dia = (d: Date) => new Intl.DateTimeFormat('pt-BR', { day: '2-digit' }).format(d);
const mes = (d: Date) =>
  new Intl.DateTimeFormat('pt-BR', { month: 'short' }).format(d).replace('.', '');
const ano = (d: Date) => d.getFullYear();
const completo = (d: Date) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long' }).format(d);
---

<Base
  title="Encontros"
  description="Agenda dos encontros de moto e moto casais onde Cieri e Milla vão estar."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">
        <span data-agenda-resumo>Agenda · {confirmados.length > 0
          ? `${confirmados.length} ${confirmados.length === 1 ? 'encontro' : 'encontros'} pela frente`
          : 'em preparação'}</span>
      </p>
      <h1 class="display">Encontros</h1>
      <div class="page-head__bottom">
        <p>
          Os encontros são a desculpa. O motivo é rever os amigos e conhecer gente nova. Se
          você também vai em algum desses, avisa — a gente combina de chegar junto.
        </p>
        <a
          class="btn btn--solid"
          href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Vou em um encontro também! Vamos combinar?')}`}
          target="_blank"
          rel="noopener">{confirmados.length > 0 ? 'Combinar comboio' : 'Falar com a gente'}</a
        >
      </div>
    </div>
  </header>

  {
    dadosContagem.length > 0 && (
      <section class="section section--tight" aria-label="Contagem regressiva" data-secao-contagem hidden={!destaque}>
        <div class="wrap">
          <div
            class="contagem"
            data-contagem
            data-eventos={JSON.stringify(dadosContagem)}
          >
            <div>
              <p class="eyebrow" data-contagem-titulo>{destaque && estado(destaque) === 'andamento' ? 'Já começou! Contagem para o término' : 'Contagem para o início'}</p>
              <p class="contagem__nome">{destaque?.data.nome ?? 'Agenda de encontros'}</p>
              <p class="contagem__local">
                {destaque ? `${destaque.data.cidade} — ${destaque.data.uf}` : ''}
              </p>
            </div>
            <div class="contagem__nums">
              <span><strong data-dias>—</strong><em>dias</em></span>
              <span><strong data-horas>—</strong><em>horas</em></span>
              <span><strong data-min>—</strong><em>min</em></span>
              <span><strong data-seg>—</strong><em>seg</em></span>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <div class="wrap filtro-estado" data-filtro-estado hidden>
    <label for="agenda-uf">Filtrar por estado</label>
    <select id="agenda-uf">
      <option value="">Todos os estados</option>
      {estados.map(uf => <option value={uf}>{uf}</option>)}
    </select>
    <p>Confira a divulgação do organizador antes de sair. Fontes e datas de conferência aparecem quando informadas.</p>
  </div>
  <nav class="wrap categorias" aria-label="Categorias de encontros" data-categorias hidden>
    {grupos.map(grupo => (
      <button type="button" class="categoria" data-filtro={grupo.id} aria-pressed={grupo.id === 'andamento'}>
        {grupo.titulo} <span data-total={grupo.id}>{grupo.itens.length}</span>
      </button>
    ))}
  </nav>
  <p class="wrap categoria-vazia" data-categoria-vazia role="status" hidden></p>

  {grupos.map(grupo => (
  <section class="section section--tight" data-grupo={grupo.id} hidden={grupo.itens.length === 0}>
    <div class="wrap">
      <h2 class="grupo-titulo">{grupo.titulo}</h2>
      <div class="lista">
        {
          grupo.itens.map((e, i) => (
            <article
              class:list={['evento', { 'evento--cancelado': e.data.cancelado }]}
              data-evento
              id={`encontro-${e.id}`}
              data-uf={e.data.uf.trim().toUpperCase()}
              data-inicio={limitesEncontro(e.data.inicio, e.data.fim).inicio}
              data-fim={limitesEncontro(e.data.inicio, e.data.fim).fim}
              data-cancelado={String(e.data.cancelado)}
              data-confirmado={String(e.data.confirmado)}
              style={`--reveal-delay:${i * 60}ms`}
            >
              <div class="evento__data">
                <span class="evento__dia">{dia(e.data.inicio)}</span>
                <span class="evento__mes">{mes(e.data.inicio)}</span>
                <span class="evento__ano">{ano(e.data.inicio)}</span>
              </div>

              <div class="evento__corpo">
                <div class="evento__topo">
                  <h3 class="evento__nome">{e.data.nome}</h3>
                  {!e.data.cancelado && <span class="evento__estado" data-estado>{estado(e) === 'passado' ? 'Encerrado' : !e.data.confirmado ? 'A confirmar' : estado(e) === 'andamento' ? 'Ocorrendo agora' : 'Em breve'}</span>}
                  {e.data.cancelado && <span class="evento__cancelado">Cancelado</span>}
                  {!e.data.cancelado && !e.data.confirmado && estado(e) === 'passado' && (
                    <span class="evento__aviso">a confirmar</span>
                  )}
                </div>
                <p class="evento__local">
                  {e.data.cidade} — {e.data.uf}
                  {e.data.local && <span class="evento__extra"> · {e.data.local}</span>}
                </p>
                {e.data.fim && (
                  <p class="evento__fim">
                    De {completo(e.data.inicio)} a {completo(e.data.fim)}
                  </p>
                )}
                {!e.data.cancelado && <p class="evento__relogio" data-relogio hidden>Já começou! Termina em <strong data-restante />.</p>}
                {e.data.observacao && !e.data.cancelado && (
                  <p class="evento__obs">{e.data.observacao}</p>
                )}
                {fonteEncontro(e.data.fonteUrl) && <p class="evento__obs"><a href={fonteEncontro(e.data.fonteUrl)} target="_blank" rel="noopener noreferrer">Ver fonte oficial ↗</a></p>}
                {dataConferencia(e.data.conferidoEm) && <p class="evento__obs">Última conferência: <time datetime={e.data.conferidoEm}>{e.data.conferidoEm!.split('-').reverse().join('/')}</time></p>}
                {e.data.cancelado && (
                  <p class="evento__motivo">
                    <strong>Por que cancelou:</strong>{' '}
                    {e.data.motivoCancelamento ?? 'o encontro não vai mais acontecer.'}
                  </p>
                )}
              </div>

              <div class="evento__acao">
                <a class="link-arrow" href={compartilharEncontro(e)} target="_blank" rel="noopener noreferrer" aria-label={`Compartilhar ${e.data.nome} no WhatsApp`}>Compartilhar no WhatsApp ↗</a>
                {!e.data.cancelado && (
                  <a
                    class="link-arrow"
                    data-comboio
                    href={`https://wa.me/${site.whatsapp}`}
                    target="_blank"
                    rel="noopener"
                  >
                    Vou também →
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  ))}
  <div class="wrap aviso-agenda" data-agenda-vazia hidden={todos.length > 0}>
    <p>A agenda nova está sendo montada. Assim que tivermos encontros cadastrados, eles aparecem aqui.</p>
  </div>

  <section class="section section--paper2 section--tight">
    <div class="wrap info">
      <div>
        <p class="eyebrow">A gente também vai</p>
        <h2 class="info__title">Encontro que não está na lista?</h2>
      </div>
      <div>
        <p>
          Manda o nome, a cidade e a data. A gente avalia a distância, o calendário — e quase
          sempre acaba indo. Estrada boa é estrada com destino.
        </p>
        <a class="btn" href={`mailto:${site.email}?subject=Indica%C3%A7%C3%A3o%20de%20encontro`}>
          Indicar um encontro
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { categoriaEncontro } from '../lib/categorias-encontros.js';
  import { estadoEncontro, tempoRestante } from '../lib/tempo-encontros';
  const caixa = document.querySelector<HTMLElement>('[data-contagem]');
  const secao = document.querySelector<HTMLElement>('[data-secao-contagem]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-evento]')];
  type Evento = { inicio: number; fim: number; nome: string; local: string; uf?: string };
  const eventos: Evento[] = JSON.parse(caixa?.dataset.eventos ?? '[]');
  const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo]')];
  let selecionada = 'andamento';
  const uf = document.querySelector<HTMLSelectElement>('#agenda-uf');
  const blocoUf = document.querySelector<HTMLElement>('[data-filtro-estado]');
  if (blocoUf) blocoUf.hidden = false;
  const filtros = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const vazio = document.querySelector<HTMLElement>('[data-categoria-vazia]');
  document.querySelector<HTMLElement>('[data-categorias]')!.hidden = false;
  const filtrar = () => {
    cards.forEach(card => { card.hidden = Boolean(uf?.value && card.dataset.uf !== uf.value); });
    grupos.forEach(g => {
      const total = [...g.querySelectorAll<HTMLElement>('[data-evento]')].filter(c => !c.hidden).length;
      g.hidden = g.dataset.grupo !== selecionada || total === 0;
      const contador = document.querySelector(`[data-total="${g.dataset.grupo}"]`);
      if (contador) contador.textContent = String(total);
    });
    filtros.forEach(f => f.setAttribute('aria-pressed', String(f.dataset.filtro === selecionada)));
    if (vazio) {
      vazio.hidden = grupos.some(g => !g.hidden);
      const mensagens: Record<string, string> = {
        andamento: 'Nenhum encontro ocorrendo agora. Confira os próximos encontros nas outras categorias.',
        futuro: 'Nenhum próximo encontro confirmado no momento.',
        confirmar: 'Nenhum encontro aguardando confirmação.',
        passado: 'Nenhum encontro encerrado na agenda.',
        cancelado: 'Nenhum encontro cancelado na agenda.',
      };
      const mensagem = mensagens[selecionada] + (uf?.value ? ` Estado selecionado: ${uf.value}.` : '');
      if (vazio.textContent !== mensagem) vazio.textContent = mensagem;
    }
  };
  filtros.forEach(f => f.addEventListener('click', () => {
    selecionada = f.dataset.filtro!;
    filtrar();
  }));
  uf?.addEventListener('change', () => tique());
  const tique = () => {
    const agora = Date.now();
    cards.forEach(card => {
      const estado = estadoEncontro(Number(card.dataset.inicio), Number(card.dataset.fim), agora);
      const cancelado = card.dataset.cancelado === 'true';
      const confirmado = card.dataset.confirmado === 'true';
      const grupo = categoriaEncontro(estado, cancelado, confirmado);
      const lista = document.querySelector(`[data-grupo="${grupo}"] .lista`);
      if (lista && card.parentElement !== lista) {
        lista.append(card);
        [...lista.children].sort((a,b) => grupo === 'passado'
          ? Number((b as HTMLElement).dataset.inicio) - Number((a as HTMLElement).dataset.inicio)
          : Number((a as HTMLElement).dataset.inicio) - Number((b as HTMLElement).dataset.inicio))
          .forEach(el => lista.append(el));
      }
      const selo = card.querySelector('[data-estado]');
      if (selo) selo.textContent = estado === 'passado' ? 'Encerrado' : !confirmado ? 'A confirmar' : estado === 'andamento' ? 'Ocorrendo agora' : 'Em breve';
      card.classList.toggle('evento--andamento', estado === 'andamento' && !cancelado && confirmado);
      const relogio = card.querySelector<HTMLElement>('[data-relogio]');
      if (relogio) {
        relogio.hidden = estado !== 'andamento' || !confirmado;
        const t = tempoRestante(Number(card.dataset.fim), agora);
        relogio.querySelector('[data-restante]')!.textContent = `${t.dias}d ${t.horas}h ${t.minutos}min ${t.segundos}s`;
      }
      const acao = card.querySelector<HTMLElement>('[data-comboio]');
      if (acao) acao.hidden = estado === 'passado' || !confirmado;
    });
    filtrar();
    const eventosEstado = eventos.filter(e => !uf?.value || e.uf === uf.value);
    const ativos = eventosEstado.filter(e => agora < e.fim).length;
    const resumo = document.querySelector('[data-agenda-resumo]');
    if (resumo) resumo.textContent = ativos ? `Agenda · ${ativos} ${ativos === 1 ? 'encontro na agenda' : 'encontros na agenda'}` : 'Agenda · sem novos encontros';
    const proximo = eventosEstado.find(e => e.inicio <= agora && agora < e.fim) ?? eventosEstado.find(e => e.inicio > agora);
    if (secao) secao.hidden = !proximo;
    if (!caixa || !proximo) return;
    const acontecendo = agora >= proximo.inicio;
    caixa.querySelector('[data-contagem-titulo]')!.textContent = acontecendo ? 'Já começou! Contagem para o término' : 'Contagem para o início';
    caixa.querySelector('.contagem__nome')!.textContent = proximo.nome;
    caixa.querySelector('.contagem__local')!.textContent = `${proximo.local} · horário de Recife · término ao final do último dia`;
    const t = tempoRestante(acontecendo ? proximo.fim : proximo.inicio, agora);
    for (const [attr, valor] of [['dias', t.dias], ['horas', t.horas], ['min', t.minutos], ['seg', t.segundos]]) {
      caixa.querySelector(`[data-${attr}]`)!.textContent = valor;
    }
  };
  const abrirLink = () => {
    const alvo = cards.find(c => `#${c.id}` === window.location.hash);
    if (!alvo) return;
    if (uf) uf.value = '';
    selecionada = categoriaEncontro(estadoEncontro(Number(alvo.dataset.inicio),Number(alvo.dataset.fim),Date.now()),alvo.dataset.cancelado === 'true',alvo.dataset.confirmado === 'true');
    tique();
    alvo.scrollIntoView?.({block:'start'});
  };
  tique();
  abrirLink();
  window.addEventListener('hashchange', abrirLink);
  const relogio = window.setInterval(tique, 1000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) tique(); });
  window.addEventListener('pagehide', () => window.clearInterval(relogio));
</script>

<style>
  .filtro-estado { padding-top: 1.5rem; }
  .filtro-estado label { display: block; margin-bottom: .5rem; }
  .filtro-estado select { padding: .7rem; background: var(--paper-2); color: var(--ink); border: 1px solid var(--line-strong); max-width: 100%; }
  .filtro-estado p { margin-top: .75rem; color: var(--ink-soft); }
  [data-evento][hidden] { display: none; }
  [data-evento] { scroll-margin-top: 120px; }
  .evento__acao { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }

  .categorias { display: flex; flex-wrap: wrap; gap: 0.65rem; padding-block: 1.5rem; }
  .categorias[hidden], .categoria-vazia[hidden] { display: none; }
  .categoria {
    font: 600 0.85rem var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    padding: 0.8rem 1rem;
    min-height: 44px;
    cursor: pointer;
  }
  .categoria[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .categoria:hover { border-color: var(--rust-text); }
  .categoria:focus-visible { outline: 2px solid var(--rust-text); outline-offset: 4px; }
  .categoria span { margin-left: 0.5rem; font-variant-numeric: tabular-nums; }
  .categoria-vazia { padding-block: 1.5rem 3rem; color: var(--ink-soft); }
  .grupo-titulo { font-family: var(--serif); font-size: 1.7rem; margin-bottom: 1rem; }

  [data-grupo][hidden], [data-secao-contagem][hidden], [data-relogio][hidden], .evento__acao[hidden] { display: none; }
  .evento__estado { font: 600 .66rem var(--sans); text-transform: uppercase; letter-spacing: .1em; color: var(--ink-soft); }
  .evento--andamento .evento__estado, .evento__relogio strong { color: var(--rust-text); }
  .evento--andamento { border-left: 2px solid var(--rust); padding-left: 1rem; }
  .evento__relogio { font-size: .9rem; margin-top: .5rem; }

  .contagem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem 2.5rem;
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    padding: clamp(1.3rem, 3vw, 2rem);
  }

  .contagem__nome {
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.15;
    margin: 0.1rem 0 0.35rem;
  }

  .contagem__local {
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
  }

  .contagem__nums {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .contagem__nums span {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 42px;
  }

  .contagem__nums strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 4.4vw, 3rem);
    line-height: 1;
    color: var(--rust-text);
    font-variant-numeric: tabular-nums;
  }

  .contagem__nums em {
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-top: 0.35rem;
  }

  .aviso-agenda {
    border: 1px dashed var(--line-strong);
    padding: clamp(1.3rem, 3vw, 2.1rem);
    max-width: 64ch;
  }

  .aviso-agenda__titulo {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.15;
    margin-bottom: 0.7rem;
  }

  .aviso-agenda__texto {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-bottom: 1.4rem;
  }

  .aviso-agenda__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.6rem;
  }

  .sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .lista {
    border-top: 1px solid var(--line-strong);
  }

  .evento {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: clamp(1.2rem, 2.4vw, 1.8rem);
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .evento__data {
    display: grid;
    justify-items: center;
    border: 1px solid var(--line-strong);
    padding: 0.6rem 0.4rem 0.5rem;
    background: var(--paper-2);
  }

  .evento__dia {
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 1;
  }

  .evento__mes {
    font-family: var(--sans);
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rust-text);
  }

  .evento__ano {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
  }

  .evento__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }

  .evento__nome {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
  }

  .evento__aviso {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    border: 1px dashed var(--line-strong);
    padding: 0.1rem 0.4rem;
  }

  /* ---------- encontro cancelado ---------- */

