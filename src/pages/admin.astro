---
/**
 * /admin — painel do casal.
 *
 * Fica fora de qualquer menu: só quem digita o endereço chega aqui. O HTML é
 * um casco vazio; toda a tela é montada pelo script (src/scripts/admin.js),
 * que fala direto com o Supabase.
 */
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/500.css';
import '@fontsource/bodoni-moda/700.css';
import '@fontsource/barlow-condensed/400.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { url } from '../lib/url';

const endereco = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const chave = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Painel — Casal na Estrada</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#16130e" />
    <link rel="icon" href={url("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={url("/favicon-48.png")} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={url('/media/logo-144.png')} />
  </head>

  <body class="pn-body">
    <div id="pn-app">
      <p class="pn-carregando">Abrindo o painel…</p>
    </div>

    <div
      id="pn-config"
      data-url={endereco}
      data-chave={chave}
      data-base={url('/')}
      hidden
    >
    </div>

    <script>
      import '../scripts/admin.js';
    </script>
  </body>
</html>

<style is:global>
  /*
   * O painel é ferramenta de trabalho: continua no papel claro, mesmo com o
   * site de noite. Só aqui os tons antigos voltam a valer.
   */
  :root {
    --paper: #ece5d6;
    --paper-2: #e2d9c6;
    --paper-3: #d8ceb8;
    --ink: #16130e;
    --ink-2: #2a251c;
    --ink-soft: #514a3d;
    --ink-mute: #7c7361;
    --rust: #a5331d;
    --rust-soft: #c0573c;
    --rust-text: #a5331d;
    --couro: #16130e;
    --line: rgba(22, 19, 14, 0.18);
    --line-strong: rgba(22, 19, 14, 0.42);
    --paper-line: rgba(22, 19, 14, 0.22);
  }

  /* ============================================================
     Painel — mesma paleta do site, tipografia de jornal.
     Todas as classes começam com "pn-" para não brigar com o site.
     ============================================================ */

  .pn-body {
    background: var(--paper);
    color: var(--ink-2);
    font-family: var(--body);
    margin: 0;
    min-height: 100vh;
  }

  .pn-carregando {
    padding: 3rem var(--gutter);
    font-family: var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  /* ---------- tela de entrada ---------- */

  .pn-entrada {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 5vw, 4rem);
    background:
      radial-gradient(circle at 50% 0%, rgba(165, 51, 29, 0.07), transparent 60%),
      var(--paper);
  }

  .pn-entrada__caixa {
    width: min(430px, 100%);
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    padding: clamp(1.6rem, 4vw, 2.6rem);
  }

  .pn-marca {
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 1.1;
    margin: 0;
    color: var(--ink);
  }

  .pn-marca span {
    display: block;
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rust);
    margin-top: 0.45rem;
  }

  .pn-esqueci {
    margin: 1.8rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-mute);
  }

  .pn-sub {
    margin: 1rem 0 1.6rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* ---------- formulários ---------- */

  .pn-campo {
    display: block;
    margin-bottom: 1rem;
  }

  .pn-campo > span {
    display: block;
    font-family: var(--sans);
    font-size: 0.76rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }

  .pn-campo > span em {
    color: var(--rust);
    font-style: normal;
  }

  .pn-campo input[type='text'],
  .pn-campo input[type='email'],
  .pn-campo input[type='password'],
  .pn-campo input[type='date'],
  .pn-campo input[type='number'],
  .pn-campo select,
  .pn-campo textarea {
    width: 100%;
    font-family: var(--body);
    font-size: 0.95rem;
    color: var(--ink);
    background: #f6f1e6;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    padding: 0.6rem 0.7rem;
    -webkit-appearance: none;
    appearance: none;
  }

  .pn-campo textarea {
    min-height: 7rem;
    line-height: 1.55;
    resize: vertical;
  }

  .pn-campo textarea.pn-grande {
    min-height: 16rem;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.86rem;
  }

  .pn-campo input:focus-visible,
  .pn-campo select:focus-visible,
  .pn-campo textarea:focus-visible {
    outline: 2px solid var(--rust);
    outline-offset: 1px;
  }

  .pn-dica {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--ink-mute);
  }

  .pn-grade {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0 1rem;
  }

  .pn-grade > * {
    grid-column: span 6;
    min-width: 0;
  }

  @media (max-width: 700px) {
    .pn-grade > * {
      grid-column: span 6 !important;
    }
  }

  .pn-check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
    margin: 0 0 1rem;
    cursor: pointer;
  }

  .pn-check input {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--rust);
  }

  /* ---------- botões ---------- */

  .pn-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: var(--sans);
    font-size: 0.86rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    padding: 0.62rem 1.15rem;
    cursor: pointer;
    border-radius: 0;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .pn-btn:hover {
    background: var(--rust);
    border-color: var(--rust);
  }

  .pn-btn:disabled {
    opacity: 0.5;
    cursor: progress;
  }

  .pn-btn--claro {
    background: transparent;
    color: var(--ink);
  }

  .pn-btn--claro:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .pn-btn--texto {
    background: none;
    border: none;
    color: var(--rust);
    padding: 0.3rem 0;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.85rem;
    font-family: var(--body);
    text-decoration: underline;
    cursor: pointer;
  }

  .pn-btn--perigo {
    color: #8c2a15;
    border-color: rgba(140, 42, 21, 0.4);
  }

  .pn-btn--perigo:hover {
    background: #8c2a15;
    border-color: #8c2a15;
    color: var(--paper);
  }

  .pn-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }

  /* ---------- barra do painel ---------- */

  .pn-topo {
    background: var(--ink);
    color: var(--paper);
    padding: 0.7rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    align-items: center;
    justify-content: space-between;
  }

  .pn-topo a,
  .pn-topo button {
    color: var(--paper);
  }

  .pn-topo__marca {
    font-family: var(--serif);
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }

  .pn-topo__marca b {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #d98b74;
    font-weight: 600;
    margin-left: 0.5rem;
  }

  .pn-topo__direita {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pn-topo__direita .pn-quem {
    color: rgba(236, 229, 214, 0.6);
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--body);
    font-size: 0.78rem;
  }

  .pn-topo__direita a:hover,
  .pn-topo__direita button:hover {
    color: var(--rust-soft);
  }

  .pn-topo__direita button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  /* ---------- abas ---------- */

  .pn-abas {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-bottom: 1px solid var(--line-strong);
    padding-inline: var(--gutter);
    background: var(--paper-2);
  }

  .pn-aba {
    font-family: var(--sans);
    font-size: 0.84rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 0.85rem 1.1rem;
    cursor: pointer;
  }

  .pn-aba[aria-current='true'] {
    color: var(--ink);
    border-bottom-color: var(--rust);
  }

  /* ---------- área ---------- */

  .pn-area {
    padding: clamp(1.2rem, 3vw, 2.4rem) var(--gutter) 5rem;
    max-width: 1080px;
  }

  .pn-cabeca {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.9rem;
    margin-bottom: 1.6rem;
  }

  .pn-cabeca h2 {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1;
    margin: 0;
    color: var(--ink);
  }

  .pn-cabeca p {
    margin: 0.45rem 0 0;
    font-size: 0.86rem;
    color: var(--ink-mute);
  }

  .pn-lista {
    display: grid;
    gap: 0.7rem;
  }

  .pn-item {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    gap: 1rem;
    align-items: center;
    border: 1px solid var(--line);
    background: var(--paper-2);
    padding: 0.6rem;
  }

  .pn-item__foto {
    width: 84px;
    height: 62px;
    background: var(--paper-3);
    border: 1px solid var(--line);
    object-fit: cover;
    display: block;
  }

  .pn-item__texto h3 {
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.2;
    margin: 0 0 0.3rem;
    color: var(--ink);
  }

  .pn-item__texto p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-mute);
  }

  .pn-item__acoes {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .pn-selo {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--line-strong);
    padding: 0.1rem 0.4rem;
    color: var(--ink-soft);
    margin-left: 0.15rem;
  }

  .pn-selo--rascunho {
    border-color: var(--rust);
    color: var(--rust);
  }

  .pn-selo--cancelado {
    background: var(--rust);
    border-color: var(--rust);
    color: var(--paper);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .pn-item__motivo {
    font-size: 0.82rem;
    color: var(--ink-soft);
    border-left: 2px solid var(--rust);
    padding-left: 0.55rem;
    margin: 0.15rem 0 0;
  }

  /* ---------- diálogo (cancelar encontro) ---------- */

  .pn-dialogo {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: rgba(12, 10, 8, 0.7);
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .pn-dialogo__caixa {
    width: min(460px, 100%);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    padding: clamp(1.1rem, 3vw, 1.6rem);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    display: grid;
    gap: 0.9rem;
  }

  .pn-dialogo__caixa h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0;
    line-height: 1.1;
  }

  .pn-dialogo__sub {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: -0.4rem 0 0;
  }

  .pn-dialogo__texto {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .pn-dialogo__caixa textarea {
    width: 100%;
    min-height: 80px;
    resize: vertical;
  }

  @media (max-width: 620px) {
    .pn-item {
      grid-template-columns: 64px 1fr;
    }
    .pn-item__foto {
      width: 64px;
      height: 52px;
    }
    .pn-item__acoes {
      grid-column: 1 / -1;
      justify-content: flex-start;
      border-top: 1px solid var(--line);
      padding-top: 0.5rem;
    }
  }

  .pn-vazio {
    border: 1px dashed var(--line-strong);
    padding: 2.4rem 1.4rem;
    text-align: center;
    color: var(--ink-mute);
    font-size: 0.9rem;
  }

  /* ---------- formulário ---------- */

  .pn-form {
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    padding: clamp(1.1rem, 3vw, 2rem);
  }

  .pn-secao {
    border-top: 1px solid var(--line);
    margin-top: 1.6rem;
    padding-top: 1.2rem;
  }

  .pn-secao > h3 {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 1rem;
  }

  .pn-rodape-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
    border-top: 1px solid var(--line-strong);
    margin-top: 1.8rem;
    padding-top: 1.2rem;
    position: sticky;
    bottom: 0;
    background: var(--paper-2);
    padding-bottom: 0.8rem;
  }

  .pn-rodape-form .pn-nota {
    font-size: 0.78rem;
    color: var(--ink-mute);
    margin-left: auto;
    max-width: 40ch;
  }

  /* ---------- envio de imagem ---------- */

  .pn-upload {
    display: grid;
    gap: 0.6rem;
  }

  .pn-upload__previa {
    position: relative;
    width: min(260px, 100%);
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line-strong);
    background: var(--paper-3);
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--ink-mute);
    font-size: 0.78rem;
    text-align: center;
    padding: 0.5rem;
  }

  .pn-upload__previa img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pn-upload__barra {
    height: 4px;
    background: var(--paper-3);
    border: 1px solid var(--line);
    display: none;
  }

  .pn-upload__barra[data-ativo='true'] {
    display: block;
  }

  .pn-upload__barra i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--rust);
    transition: width 0.2s ease;
  }

  .pn-fotos {
    display: grid;
    gap: 0.7rem;
  }

  .pn-foto-item {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 0.8rem;
    align-items: start;
    border: 1px solid var(--line);
    background: #f6f1e6;
    padding: 0.5rem;
  }

  .pn-foto-item img {
    width: 96px;
    height: 72px;
    object-fit: cover;
    display: block;
  }

  .pn-foto-item input[type='text'] {
    width: 100%;
    font-size: 0.86rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line);
    background: #fffdf7;
  }

  .pn-foto-item small {
    display: block;
    font-size: 0.72rem;
    color: var(--ink-mute);
    margin-top: 0.25rem;
    word-break: break-all;
  }

  .pn-video-item {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.6rem;
    align-items: center;
    border: 1px solid var(--line);
    background: #f6f1e6;
    padding: 0.5rem;
  }

  .pn-video-item input {
    width: 100%;
    font-size: 0.86rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line);
    background: #fffdf7;
  }

  @media (max-width: 620px) {
    .pn-foto-item,
    .pn-video-item {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- avisos ---------- */

  .pn-aviso {
    border-left: 3px solid var(--rust);
    background: rgba(165, 51, 29, 0.06);
    padding: 0.7rem 0.9rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0 0 1.2rem;
  }

  .pn-aviso a {
    color: var(--rust);
  }

  /* ---------- faixa de publicação automática ---------- */

  .pn-faixa:empty {
    display: none;
  }

  .pn-faixa {
    padding: 1rem var(--gutter) 0;
    max-width: 1080px;
  }

  .pn-aviso--faixa {
    margin-bottom: 0;
  }

  .pn-aviso--faixa p {
    margin: 0 0 0.7rem;
  }

  .pn-aviso details {
    margin-top: 0.2rem;
  }

  .pn-aviso summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--rust);
  }

  .pn-aviso ol {
    margin: 0.6rem 0 0 1.1rem;
    padding: 0;
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .pn-aviso ol li {
    margin-bottom: 0.3rem;
  }

  .pn-aviso a {
    color: var(--rust);
    word-break: break-all;
  }

  #pn-token {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.82rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line-strong);
    background: #fffdf7;
    color: var(--ink);
    border-radius: 0;
  }

  .pn-topo__direita #pn-publicar {
    border: 1px solid rgba(236, 229, 214, 0.45);
    padding: 0.28rem 0.7rem;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .pn-topo__direita #pn-publicar:hover {
    background: var(--rust);
    border-color: var(--rust);
    color: #fff;
  }

  .pn-toast {
    position: fixed;
    left: 50%;
    bottom: 1.4rem;
    transform: translate(-50%, 150%);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.88rem;
    padding: 0.75rem 1.2rem;
    max-width: min(520px, calc(100vw - 2rem));
    transition: transform 0.25s ease;
    z-index: 50;
    box-shadow: 0 10px 30px rgba(22, 19, 14, 0.25);
  }

  .pn-toast[data-aberto='true'] {
    transform: translate(-50%, 0);
  }

  .pn-toast[data-tom='erro'] {
    background: #8c2a15;
  }
  /* ---------- ponto de recorte ---------- */

  .pn-foco {
    display: grid;
    gap: 0.5rem;
    max-width: 340px;
  }

  .pn-foco__area {
    position: relative;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line-strong);
    background: var(--paper-3);
    overflow: hidden;
    cursor: crosshair;
    touch-action: manipulation;
  }

  .pn-foco__area img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    display: block;
  }

  .pn-foco__mira {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border: 2px solid var(--rust);
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(236, 229, 214, 0.8);
    pointer-events: none;
  }

  .pn-foco__area[data-marcado='nao'] .pn-foco__mira {
    opacity: 0.45;
  }

  /* ---------- filtro da lista ---------- */

  .pn-filtrar {
    display: flex;
    flex-wrap: wrap;
