---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../data/site';
import { carregarPosts, postsNoAr, type Post } from '../../lib/dados';
import { markdown } from '../../lib/markdown';

interface Props {
  post: Post;
}

export async function getStaticPaths() {
  const posts = postsNoAr(await carregarPosts());
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as Props;
const corpo = markdown(post.body);
const { data } = post;

const todos = postsNoAr(await carregarPosts());
const indice = todos.findIndex((p) => p.id === post.id);

// `todos` está do mais novo para o mais antigo: anterior é a publicação mais
// nova, próximo é a mais antiga — como num caderno folheado de trás pra frente.
const anterior = todos[indice - 1] ?? null;
const proximo = todos[indice + 1] ?? null;

// Número da edição: a mais antiga é a nº 1.
const edicao = todos.length - indice;

// "Leia também": primeiro do mesmo lugar, depois do mesmo tipo, depois recentes.
const vetados = new Set([post.id, anterior?.id, proximo?.id]);
const leiaTambem = [
  ...todos.filter((p) => !vetados.has(p.id) && p.data.local === post.data.local),
  ...todos.filter((p) => !vetados.has(p.id) && p.data.tipo === post.data.tipo),
  ...todos.filter((p) => !vetados.has(p.id)),
]
  .filter((p, i, lista) => lista.findIndex((q) => q.id === p.id) === i)
  .slice(0, 2);

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://casalnaestrada.com.br');
const compartilhar = `https://wa.me/?text=${encodeURIComponent(`${data.titulo} — ${site.nome}\n${canonical.href}`)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.titulo,
  description: data.resumo,
  image: [new URL(url(data.capa), canonical).href],
  datePublished: data.data.toISOString(),
  dateModified: data.data.toISOString(),
  articleSection: data.tipo,
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
  contentLocation: { '@type': 'Place', name: [data.local, data.uf].filter(Boolean).join(' — ') },
  author: { '@type': 'Person', name: site.nomes },
  publisher: { '@type': 'Organization', name: site.nome },
};

const dataLonga = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(data.data);

/** Extrai o ID de um link do YouTube em qualquer formato comum. */
const youtubeId = (link?: string) => {
  if (!link) return null;
  const m = link.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([A-Za-z0-9_-]{6,})/);
  return m ? m[1] : null;
};
const video = youtubeId(data.video);

const palavras = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const leitura = Math.max(1, Math.round(palavras / 200));
import { url } from '../../lib/url';
---

<Base title={data.titulo} description={data.resumo} image={data.capa}>
  <div class="progresso" id="progresso" aria-hidden="true"></div>

  <article>
    <header class="hero-post">
      <div class="wrap hero-post__in">
        <div class="hero-post__meta">
          <a class="back" href={url("/diario")}>← Diário</a>
          <span class="hero-post__selo">
            <span class="hero-post__tipo">{data.tipo}</span>
            <span class="hero-post__edicao">Edição nº {edicao}</span>
          </span>
        </div>
        <h1 class="hero-post__title">{data.titulo}</h1>
        <p class="hero-post__resumo">{data.resumo}</p>
        <dl class="hero-post__facts">
          <div>
            <dt>Data</dt>
            <dd>{dataLonga}</dd>
          </div>
          <div>
            <dt>Onde</dt>
            <dd>{data.local}{data.uf ? ` — ${data.uf}` : ''}</dd>
          </div>
          {
            data.distancia && (
              <div>
                <dt>Distância</dt>
                <dd>{data.distancia}</dd>
              </div>
            )
          }
          <div>
            <dt>Leitura</dt>
            <dd>{leitura} min</dd>
          </div>
        </dl>
      </div>
    </header>

    <figure class="hero-post__figure wrap">
      <div
        class="photo photo--duotone hero-post__photo"
        data-ampliar
        data-foco={data.capaFoco}
        role="button"
        tabindex="0"
        aria-label="Ver a foto inteira"
      >
        <img src={url(data.capa)} alt={data.capaAlt} width="1600" height="1000" />
        <span class="hero-post__zoom">Ampliar a foto ⤢</span>
      </div>
      <figcaption class="legenda">{data.capaAlt}</figcaption>
    </figure>

    {
      video && (
        <section class="wrap video-post">
          <div class="video-post__quadro">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${video}`}
              title={`Vídeo: ${data.titulo}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            />
          </div>
          <p class="video-post__legenda">Vídeo gravado na estrada pelo casal.</p>
        </section>
      )
    }

    <div class="wrap artigo">
      <div class="artigo__body prose">
        <Fragment set:html={corpo} />
      </div>

      <aside class="artigo__aside">
        <div class="aside-card">
          <p class="eyebrow">Assinado por</p>
          <p class="aside-card__nome">{site.nomes}</p>
          <p class="aside-card__bio">
            Casal de Recife na estrada desde {site.desde}. Rodamos o Brasil atrás de encontros
            de moto e boas conversas.
          </p>
          <a class="link-arrow" href={url("/sobre")}>Conhecer o casal →</a>
        </div>

        {
          data.tags.length > 0 && (
            <div class="aside-card">
              <p class="eyebrow">Marcadores</p>
              <div class="aside-tags">
                {data.tags.map((t) => (
                  <span class="tag-chip">{t}</span>
                ))}
              </div>
            </div>
          )
        }

        <div class="aside-card aside-card--ink">
          <p class="eyebrow eyebrow--light">Vai passar por lá?</p>
          <p class="aside-card__dark">
            Se você for fazer essa estrada, chama a gente. A gente tem dica de parada, onde
            comer e que horas sair.
          </p>
          <a class="btn btn--light" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
            Falar no WhatsApp
          </a>
        </div>
      </aside>
    </div>

    <section class="compartilhar wrap">
      <p class="eyebrow">Manda para quem roda com você</p>
      <div class="compartilhar__acoes">
        <a class="btn" href={compartilhar} target="_blank" rel="noopener">
          Compartilhar no WhatsApp
        </a>
        <button class="btn" type="button" id="copiar-link" data-link={canonical.href}>
          Copiar o link
        </button>
      </div>
    </section>

    {
      (anterior || proximo) && (
        <nav class="folhear wrap" aria-label="Outras publicações">
          {anterior ? (
            <a class="folhear__item" href={url(`/diario/${anterior.id}`)}>
              <span class="folhear__rotulo">← Mais nova</span>
              <span class="folhear__titulo">{anterior.data.titulo}</span>
            </a>
          ) : (
            <span />
          )}
          {proximo ? (
            <a class="folhear__item folhear__item--dir" href={url(`/diario/${proximo.id}`)}>
              <span class="folhear__rotulo">Mais antiga →</span>
              <span class="folhear__titulo">{proximo.data.titulo}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    {
      leiaTambem.length > 0 && (
        <section class="proximo">
          <div class="wrap">
            <p class="eyebrow">Leia também</p>
            {leiaTambem.map((p) => (
              <PostCard post={p} variante="row" />
            ))}
          </div>
        </section>
      )
    }

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </article>
</Base>

<script>
  // Barra de progresso da leitura, fininha, no topo.
  const barra = document.getElementById('progresso');
  if (barra) {
    const atualizar = () => {
      const altura = document.documentElement.scrollHeight - window.innerHeight;
      const lido = altura > 0 ? (window.scrollY / altura) * 100 : 0;
      barra.style.width = `${Math.min(100, Math.max(0, lido))}%`;
    };
    atualizar();
    window.addEventListener('scroll', atualizar, { passive: true });
    window.addEventListener('resize', atualizar);
  }

  // Copiar o link da publicação.
  const botaoCopiar = document.getElementById('copiar-link') as HTMLButtonElement | null;
  botaoCopiar?.addEventListener('click', async () => {
    const link = botaoCopiar.dataset.link ?? window.location.href;
    try {
      await navigator.clipboard.writeText(link);
      botaoCopiar.textContent = 'Link copiado ✓';
    } catch {
      botaoCopiar.textContent = 'Copie da barra do navegador';
    }
    setTimeout(() => {
      botaoCopiar.textContent = 'Copiar o link';
    }, 2400);
  });
</script>

<style>
  .hero-post {
    padding-top: clamp(1.6rem, 4vw, 2.8rem);
  }

  .hero-post__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--sans);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.6rem;
  }

  .back {
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--rust);
  }

  .hero-post__tipo {
    color: var(--rust);
    border: 1px solid var(--rust);
    padding: 0.15rem 0.5rem;
  }

  .hero-post__title {
    font-size: clamp(2rem, 5.4vw, 4.1rem);
    max-width: 26ch;
    margin-bottom: 1.1rem;
  }

  .hero-post__resumo {
    font-size: clamp(1.02rem, 0.5vw + 0.95rem, 1.22rem);
    color: var(--ink-soft);
    max-width: 62ch;
    line-height: 1.55;
  }

  .hero-post__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.4rem;
    margin: 1.6rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .hero-post__facts dt {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 0.1rem;
  }

  .hero-post__facts dd {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.02rem;
  }

  .hero-post__figure {
    margin-block: clamp(1.6rem, 3.5vw, 2.6rem) clamp(1.8rem, 4vw, 3rem);
  }

  .hero-post__photo {
    aspect-ratio: 16 / 9;
  }

  .hero-post__selo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .hero-post__edicao {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .compartilhar {
    margin-block: clamp(1.6rem, 3vw, 2.4rem);
    padding-block: clamp(1.1rem, 2vw, 1.5rem);
    border-block: 3px double var(--line-strong);
  }

  .compartilhar__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .folhear {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 3vw, 2.4rem);
    margin-block: clamp(1.4rem, 3vw, 2.2rem);
  }

  .folhear__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line-strong);
  }

  .folhear__item--dir {
    text-align: right;
    align-items: flex-end;
  }

  .folhear__rotulo {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .folhear__titulo {
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .folhear__item:hover .folhear__titulo {
    color: var(--rust);
  }

  .hero-post__zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    background: rgba(18, 15, 10, 0.78);
    color: var(--paper);
    border: 1px solid rgba(236, 229, 214, 0.35);
    padding: 0.4rem 0.75rem;
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .hero-post__figure figcaption {
    font-size: 0.78rem;
    color: var(--ink-mute);
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    margin-top: 0.6rem;
  }

  .artigo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .artigo__aside {
    display: grid;
    gap: 1.1rem;
    position: sticky;
    top: 120px;
  }

  .aside-card {
    border: 1px solid var(--line-strong);
    padding: 1.2rem;
  }

  .aside-card .eyebrow {
    margin-bottom: 0.7rem;
  }

  .aside-card__nome {
    font-family: var(--serif);
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }

  .aside-card__bio {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }

  .aside-card--ink {
    background: var(--ink);
    border-color: var(--ink);
  }

  .aside-card__dark {
    color: rgba(236, 229, 214, 0.76);
    font-size: 0.87rem;
    margin-bottom: 1rem;
  }

  .aside-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-chip {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--line-strong);
    padding: 0.2rem 0.5rem;
    color: var(--ink-soft);
  }

  .proximo {
    border-top: 1px solid var(--line-strong);
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    background: var(--paper-2);
  }

  .video-post {
    margin-block: clamp(1.6rem, 4vw, 2.6rem) clamp(1.6rem, 4vw, 2.4rem);
  }

  .video-post__quadro {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    border: 1px solid var(--line-strong);
    overflow: hidden;
  }

  .video-post__quadro iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-post__legenda {
    margin-top: 0.6rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }

  @media (max-width: 900px) {
    .artigo {
      grid-template-columns: 1fr;
    }
    .artigo__aside {
      position: static;
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* Tipografia do texto do artigo */
  .prose {
    max-width: 68ch;
    font-size: 1.06rem;
    line-height: 1.72;
    color: var(--ink-2);
  }

  .prose > p:first-of-type::first-letter {
    font-family: var(--serif);
    font-size: 3.6em;
    float: left;
    line-height: 0.82;
    padding: 0.06em 0.12em 0 0;
    color: var(--rust);
  }

  .prose h2 {
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
    margin: 2.2rem 0 0.9rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .prose h3 {
    font-size: 1.22rem;
    margin: 1.8rem 0 0.6rem;
  }

  .prose p {
    margin-bottom: 1.15em;
  }

  .prose blockquote {
    margin: 1.8rem 0;
    padding: 0.4rem 0 0.4rem 1.4rem;
    border-left: 3px solid var(--rust);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.24rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.2rem;
    margin-bottom: 1.2em;
  }

  .prose li {
    margin-bottom: 0.4em;
  }

  .prose a {
    border-bottom: 1px solid var(--rust);
    color: var(--ink);
  }

  .prose a:hover {
    color: var(--rust);
  }

  .prose strong {
    font-weight: 600;
    color: var(--ink);
  }

  .prose img {
    width: 100%;
    height: auto;
    margin-block: 1.6rem;
  }
</style>
