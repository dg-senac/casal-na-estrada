{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casal-na-estrada-site-teste",
  "main": "cloudflare/site-worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casal-emergencia-teste",
      "database_id": "8619ac9f-f536-4ded-ad00-102b5735223a"
    }
  ],
  "observability": {
    "enabled": false
  },
  "keep_vars": true
}
